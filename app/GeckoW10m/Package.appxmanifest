<?xml version="1.0" encoding="utf-8"?>
<!--
  GeckoW10m for Windows 10 Mobile.

  The two things that make the Gecko port possible are declared here:

    * rescap:codeGeneration  -> unlocks VirtualAllocFromApp / VirtualProtectFromApp
                                with executable page protections, i.e. JIT.
    * rescap:broadFileSystemAccess + rescap:unrestrictedFileSystemAccess
                             -> escape the app-container file jail (downloads,
                                profile, add-on packages).

  Restricted capabilities normally require Store approval. On an interop-unlocked
  device they are honoured for a sideloaded, self/interop-signed package.
-->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
    xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap uap3 mp rescap">

  <Identity
      Name="GeckoW10m.W10M"
      Publisher="CN=GeckoW10m"
      Version="0.1.2.8"
      ProcessorArchitecture="arm" />

  <mp:PhoneIdentity
      PhoneProductId="1c42dda2-b778-4032-9f94-8f852c3ad652"
      PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>GeckoW10m</DisplayName>
    <PublisherDisplayName>GeckoW10m</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- W10M range: Threshold 2 (10586) up to the last mobile build (15254). -->
    <TargetDeviceFamily Name="Windows.Mobile"
                        MinVersion="10.0.10586.0"
                        MaxVersionTested="10.0.15254.0" />
    <TargetDeviceFamily Name="Windows.Universal"
                        MinVersion="10.0.10586.0"
                        MaxVersionTested="10.0.15254.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
    <Resource Language="ru-RU" />
  </Resources>

  <Applications>
    <Application Id="App"
                 Executable="GeckoW10m.exe"
                 EntryPoint="GeckoW10m.App">
      <uap:VisualElements
          DisplayName="GeckoW10m"
          Description="Gecko-based web browser for Windows 10 Mobile"
          BackgroundColor="transparent"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- Register gecko_w10m:// and default-browser protocol handling. -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="gecko_w10m" />
        </uap:Extension>
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="http" />
        </uap:Extension>
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="https" />
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />
    <uap:Capability Name="removableStorage" />

    <!-- JIT. The whole reason a real Gecko engine can run here. -->
    <rescap:Capability Name="codeGeneration" />

    <!-- Escape the file jail (interop-unlock honours these when sideloaded). -->
    <rescap:Capability Name="broadFileSystemAccess" />
    <rescap:Capability Name="unrestrictedFileSystemAccess" />

    <!-- Camera / mic / location are brokered through the shell for getUserMedia. -->
    <DeviceCapability Name="microphone" />
    <DeviceCapability Name="webcam" />
    <DeviceCapability Name="location" />
  </Capabilities>
</Package>
