<?xml version="1.0" encoding="utf-8"?>
<!--
  Gecko Probe: a separate, tiny package for phones with no debugger and no
  crash dumps. Win32 only, no XAML, no WinRT, no capabilities. It asks the
  loader for each DLL the browser's start-up chain needs and writes every
  answer, with its error code, into TempState\gecko-probe.txt, where the
  Device Portal's App File Explorer can show it.

  Its own package on purpose: Windows 10 Mobile is not trusted to install a
  package with two applications, and the browser's 108 MB is a lot to
  re-upload for a thirty-line answer.
-->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
    IgnorableNamespaces="uap mp">

  <Identity
      Name="GeckoProbe"
      Publisher="CN=Computershik"
      Version="1.0.0.0"
      ProcessorArchitecture="arm" />
  <mp:PhoneIdentity
      PhoneProductId="a5545360-e8ca-4c4b-a1ec-fe1a40b39cf5"
      PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties>
    <DisplayName>Gecko Probe</DisplayName>
    <PublisherDisplayName>Computershik</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Mobile"
                        MinVersion="10.0.10586.0"
                        MaxVersionTested="10.0.15254.0" />
    <TargetDeviceFamily Name="Windows.Universal"
                        MinVersion="10.0.10586.0"
                        MaxVersionTested="10.0.15254.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="Probe"
                 Executable="Probe.exe"
                 EntryPoint="Gecko.Probe">
      <uap:VisualElements
          DisplayName="Gecko Probe"
          Description="Loader probe for the Gecko browser"
          BackgroundColor="#1C1B22"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#1C1B22" />
      </uap:VisualElements>
    </Application>
  </Applications>
</Package>
