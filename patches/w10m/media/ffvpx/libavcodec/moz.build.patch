diff --git a/media/ffvpx/libavcodec/moz.build b/media/ffvpx/libavcodec/moz.build
index f9b65533fb..3ecf06fbeb 100644
--- a/media/ffvpx/libavcodec/moz.build
+++ b/media/ffvpx/libavcodec/moz.build
@@ -7,7 +7,9 @@
 if CONFIG['FFVPX_ASFLAGS']:
     if CONFIG['TARGET_CPU'] == 'x86' or CONFIG['TARGET_CPU'] == 'x86_64':
         DIRS += ['x86']
-    elif CONFIG['TARGET_CPU'] == 'arm':
+    elif CONFIG['TARGET_CPU'] == 'arm' and CONFIG['OS_TARGET'] != 'WINNT':
+        # ffvpx's 32-bit ARM assembly is A32 (ARM mode); Windows on ARM32
