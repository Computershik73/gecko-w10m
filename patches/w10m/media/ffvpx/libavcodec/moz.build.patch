         DIRS += ['arm']
 
 if CONFIG['TARGET_CPU'] == 'aarch64':
@@ -131,8 +133,13 @@ if not CONFIG['MOZ_FFVPX_AUDIOONLY']:
     else:
         USE_LIBS += [
             'dav1d',
-            'media_libdav1d_asm',
         ]
+        # The assembly half of dav1d is not built on every target (see
+        # MOZ_DAV1D_ASM in toolkit/moz.configure).
+        if CONFIG['MOZ_DAV1D_ASM']:
+            USE_LIBS += [
+                'media_libdav1d_asm',
+            ]
 
     if CONFIG["MOZ_WIDGET_TOOLKIT"] == "gtk":
         LOCAL_INCLUDES += ['/media/mozva']
