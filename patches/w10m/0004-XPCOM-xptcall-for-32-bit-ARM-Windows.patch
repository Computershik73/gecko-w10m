+; Shared vtable stubs for Windows on 32-bit ARM (AAPCS, hard-float).
+;
+; Each StubN entry puts its own method index in r12 and tail-branches to
+; SharedStub, which spills the argument registers and hands them to
+; PrepareAndDispatch (see xptcstubs_arm.cpp):
+;
+;   PrepareAndDispatch(self, methodIndex, stackArgs, gprData, fprData)
+;
+; Stack layout while inside SharedStub (sp = entry sp - 104):
+;
+;   [sp +   0]  fprData, the fifth argument, passed on the stack
+;   [sp +   4]  padding, keeping the frame 8-byte aligned
+;   [sp +   8]  d0 - d7                                       (64 bytes)
+;   [sp +  72]  saved r1, r2, r3                              (12 bytes)
+;   [sp +  84]  padding
+;   [sp +  88]  saved r4, r5, r11, lr                         (16 bytes)
+;   [sp + 104]  the caller's stack arguments
+;
+; r0 already holds 'self' on entry and is left alone, so it is the first
+; argument to PrepareAndDispatch, and r0 on return is the result.
+
+        AREA    |.text|, CODE, READONLY, ALIGN=2
+
+        IMPORT  PrepareAndDispatch
+
+        EXPORT  SharedStub
+
+SharedStub PROC
+        push    {r4, r5, r11, lr}
+        sub     sp, sp, #88
+
+        str     r1, [sp, #72]
+        str     r2, [sp, #76]
+        str     r3, [sp, #80]
+
+        mov     r1, r12                 ; methodIndex, before r12 is reused
+        add     r12, sp, #8
+        vstm    r12, {d0-d7}
+        str     r12, [sp]               ; fprData
+        add     r2, sp, #104            ; the caller's stack arguments
+        add     r3, sp, #72             ; gprData: saved r1, r2, r3
+
+        bl      PrepareAndDispatch
+
+        add     sp, sp, #88
+        pop     {r4, r5, r11, pc}
+        ENDP
+
+        MACRO
+        STUBENTRY $functionname, $paramcount
+        EXPORT  $functionname
+$functionname PROC
+        mov     r12, #$paramcount
+        b       SharedStub
+        ENDP
+        MEND
+
