 .../xptcall/md/win32/xptcinvoke_arm.cpp       | 268 +++++++++++++++
 .../xptcall/md/win32/xptcstubs_arm.cpp        | 243 ++++++++++++++
 .../xptcall/md/win32/xptcstubs_asm_arm.asm    | 310 ++++++++++++++++++
 4 files changed, 836 insertions(+)
 create mode 100644 xpcom/reflect/xptcall/md/win32/xptcinvoke_arm.cpp
 create mode 100644 xpcom/reflect/xptcall/md/win32/xptcstubs_arm.cpp
