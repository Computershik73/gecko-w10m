diff --git a/gfx/gl/GLContextProviderEGL.cpp b/gfx/gl/GLContextProviderEGL.cpp
index 728fa98356..35c704d502 100644
--- a/gfx/gl/GLContextProviderEGL.cpp
+++ b/gfx/gl/GLContextProviderEGL.cpp
@@ -12,6 +12,26 @@
     ((EGLNativeWindowType)aWidget->GetNativeData(NS_JAVA_SURFACE))
 #  define GET_NATIVE_WINDOW_FROM_COMPOSITOR_WIDGET(aWidget) \
     (aWidget->AsAndroid()->GetEGLNativeWindow())
+#elif defined(GECKO_W10M)
+// There is no HWND to give: an app container is handed none, and this widget
+// is headless. What EGL gets instead is the XAML SwapChainPanel the shell is
+// showing, which ANGLE knows how to make a composition swap chain for -- so
+// the frame is handed to the system compositor as a texture rather than
+// copied out through main memory.
+//
+// It travels as an EGLNativeWindowType because that is what EGL takes. The
+// typedef stays HWND-shaped here: this build claims the desktop API family on
+// purpose, so that the rest of Gecko keeps its Win32 APIs.
+//
+// Declared rather than included -- the panel belongs to the headless widget,
+// and gfx has no business including widget headers.
+extern "C" void* gecko_w10m_egl_native_window();
+extern "C" void GeckoW10mNote(const char* text);
+#  include "mozilla/Sprintf.h"
+#  define GET_NATIVE_WINDOW_FROM_REAL_WIDGET(aWidget) \
+    ((EGLNativeWindowType)gecko_w10m_egl_native_window())
+#  define GET_NATIVE_WINDOW_FROM_COMPOSITOR_WIDGET(aWidget) \
+    ((EGLNativeWindowType)gecko_w10m_egl_native_window())
 #elif defined(XP_WIN)
 #  define GET_NATIVE_WINDOW_FROM_REAL_WIDGET(aWidget) \
     ((EGLNativeWindowType)aWidget->GetNativeData(NS_NATIVE_WINDOW))
@@ -194,6 +214,27 @@ static EGLSurface CreateSurfaceFromNativeWindow(
   if (!newSurface) {
     const auto err = egl.mLib->fGetError();
     gfxCriticalNote << "Failed to create EGLSurface!: " << gfx::hexa(err);
+#if defined(GECKO_W10M)
+    // Here, not at the call site: fGetError clears the error, so the note
+    // above was eating it and my own read a moment later got EGL_SUCCESS.
+    //
+    // 0x3009 EGL_BAD_MATCH means the config has no window bit -- the context
+    // was made for offscreen use and its config cannot carry a window.
+    // 0x300b EGL_BAD_NATIVE_WINDOW means ANGLE looked at the panel and said no,
+    // which is the case that reaches IsValidNativeWindow.
+    char note[128];
+    SprintfLiteral(note, "gfx: eglCreateWindowSurface refused it, egl 0x%04x",
+                   unsigned(err));
+    GeckoW10mNote(note);
+    EGLint surfaceType = 0;
+    if (egl.fGetConfigAttrib(config, LOCAL_EGL_SURFACE_TYPE, &surfaceType)) {
+      SprintfLiteral(note,
+                     "gfx: the config's surface type is 0x%04x, window bit %s",
+                     unsigned(surfaceType),
+                     (surfaceType & LOCAL_EGL_WINDOW_BIT) ? "set" : "MISSING");
+      GeckoW10mNote(note);
+    }
+#endif
   }
   return newSurface;
 }
@@ -336,6 +377,10 @@ EGLSurface GLContextEGL::CreateEGLSurfaceForCompositorWidget(
   MOZ_ASSERT(aCompositorWidget);
   EGLNativeWindowType window =
       GET_NATIVE_WINDOW_FROM_COMPOSITOR_WIDGET(aCompositorWidget);
+#if defined(GECKO_W10M)
+  GeckoW10mNote(window ? "gfx: making an EGL surface for the panel"
+                     : "gfx: asked for an EGL surface but there is no panel");
+#endif
   if (!window) {
     gfxCriticalNote << "window is null";
     return EGL_NO_SURFACE;
