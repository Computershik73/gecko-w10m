+//
+
+// NativeWindow11WinRT.cpp: Implementation of NativeWindow11 for a XAML
+// SwapChainPanel.
+
+#include "libANGLE/renderer/d3d/d3d11/winrt/NativeWindow11WinRT.h"
+
+#include "libANGLE/renderer/d3d/d3d11/renderer11_utils.h"
