                 if contains_continue(body) {
                     self.err("continue inside a loop".into());
@@ -1173,6 +1276,9 @@ pub fn translate_fragment_limited(
         array_wrappers: Vec::new(),
         ret_array: None,
         loop_limit,
+        flat_names: HashSet::new(),
