index 4174ec4cb3..b947d81a4e 100644
--- a/media/ffvpx/libavutil/moz.build
+++ b/media/ffvpx/libavutil/moz.build
@@ -7,7 +7,9 @@
 if CONFIG['FFVPX_ASFLAGS']:
     if CONFIG['TARGET_CPU'] == 'x86' or CONFIG['TARGET_CPU'] == 'x86_64':
