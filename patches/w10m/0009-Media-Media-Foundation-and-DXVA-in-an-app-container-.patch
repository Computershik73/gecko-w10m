diff --git a/dom/media/platforms/wmf/DXVA2Manager.cpp b/dom/media/platforms/wmf/DXVA2Manager.cpp
index 9d5d8dffc7..8109861b5d 100644
--- a/dom/media/platforms/wmf/DXVA2Manager.cpp
+++ b/dom/media/platforms/wmf/DXVA2Manager.cpp
@@ -790,8 +790,21 @@ D3D11DXVA2Manager::InitInternal(layers::KnowsCompositor* aKnowsCompositor,
     }
   }
 
+  // Zero copy means the decoder's own NV12 texture goes to the compositor as
+  // it is, instead of being run through the video processor MFT into a fresh
+  // one for every frame. Upstream asks for the GPU process because that is
+  // where the texture has to end up; here the compositor is in this process
+  // and, with the decoder device reused, on the same D3D11 device the
+  // compositor draws with -- which is the condition that actually matters, and
+  // it is still checked. The copy costs a full frame of fill per frame, which
+  // 1080p30 has room for on this GPU and 1080p60 does not.
+#if defined(GECKO_W10M)
+  if (!IsD3D11() ||
+      (mDevice != DeviceManagerDx::Get()->GetCompositorDevice())) {
+#else
   if (!IsD3D11() || !XRE_IsGPUProcess() ||
       (mDevice != DeviceManagerDx::Get()->GetCompositorDevice())) {
+#endif
     mZeroCopyUsageInfo->DisableZeroCopyNV12Texture();
   }
 
diff --git a/dom/media/platforms/wmf/WMFUtils.cpp b/dom/media/platforms/wmf/WMFUtils.cpp
index c8abb3ec92..51b08ba5d5 100644
--- a/dom/media/platforms/wmf/WMFUtils.cpp
+++ b/dom/media/platforms/wmf/WMFUtils.cpp
@@ -426,6 +426,20 @@ void AACAudioSpecificConfigToUserData(uint8_t aAACProfileLevelIndication,
 
 namespace wmf {
 
+#if defined(GECKO_W10M)
+#  define GECKO_W10M_FOURCC(a, b, c, d) \
+    (DWORD(a) | (DWORD(b) << 8) | (DWORD(c) << 16) | (DWORD(d) << 24))
+static constexpr DWORD FOURCC_NV12 = GECKO_W10M_FOURCC('N', 'V', '1', '2');
+static constexpr DWORD FOURCC_NV21 = GECKO_W10M_FOURCC('N', 'V', '2', '1');
+static constexpr DWORD FOURCC_YV12 = GECKO_W10M_FOURCC('Y', 'V', '1', '2');
+static constexpr DWORD FOURCC_I420 = GECKO_W10M_FOURCC('I', '4', '2', '0');
+static constexpr DWORD FOURCC_IYUV = GECKO_W10M_FOURCC('I', 'Y', 'U', 'V');
+static constexpr DWORD FOURCC_P010 = GECKO_W10M_FOURCC('P', '0', '1', '0');
+static constexpr DWORD FOURCC_P016 = GECKO_W10M_FOURCC('P', '0', '1', '6');
+static constexpr DWORD FOURCC_YUY2 = GECKO_W10M_FOURCC('Y', 'U', 'Y', '2');
+static constexpr DWORD FOURCC_UYVY = GECKO_W10M_FOURCC('U', 'Y', 'V', 'Y');
+#endif
+
 static const wchar_t* sDLLs[] = {
     L"mfplat.dll",
     L"mf.dll",
@@ -450,6 +464,15 @@ LoadDLLs() {
   nsTArray<const wchar_t*> loadedDlls;
   for (const wchar_t* dll : sDLLs) {
     if (!LoadLibrarySystem32(dll)) {
+#if defined(GECKO_W10M)
+      // Windows 10 Mobile has no evr.dll for an app container to load, and
+      // the one thing wanted from it -- the stride of a bitmap format -- is
+      // arithmetic. Without this the whole of WMF was refused, and with it
+      // every H.264 and AAC stream: FFVPX carries neither.
+      if (wcscmp(dll, L"evr.dll") == 0) {
+        continue;
+      }
+#endif
       NS_WARNING("Failed to load WMF DLLs");
       for (const wchar_t* loadedDll : loadedDlls) {
         FreeLibrary(GetModuleHandleW(loadedDll));
@@ -523,6 +546,32 @@ MFCreateMediaType(IMFMediaType** aOutMFType) {
 
 HRESULT
 MFGetStrideForBitmapInfoHeader(DWORD aFormat, DWORD aWidth, LONG* aOutStride) {
+#if defined(GECKO_W10M)
+  if (!GetModuleHandleW(L"evr.dll")) {
+    // The formats the decoder hands out here. Planar 4:2:0 and NV12 have one
+    // byte per pixel on the top plane; the packed ones are as listed.
+    switch (aFormat) {
+      case FOURCC_NV12: case FOURCC_YV12: case FOURCC_I420: case FOURCC_IYUV:
+      case FOURCC_NV21: case FOURCC_P010: case FOURCC_P016:
+        *aOutStride = (aFormat == FOURCC_P010 || aFormat == FOURCC_P016)
+                          ? LONG(aWidth) * 2
+                          : LONG(aWidth);
+        return S_OK;
+      case FOURCC_YUY2: case FOURCC_UYVY:
+        *aOutStride = LONG(aWidth) * 2;
+        return S_OK;
+      case 22 /* D3DFMT_A8R8G8B8, MFVideoFormat_ARGB32 */:
+      case 21 /* D3DFMT_X8R8G8B8, MFVideoFormat_RGB32 */:
+        *aOutStride = LONG(aWidth) * 4;
+        return S_OK;
+      case 20 /* MFVideoFormat_RGB24 */:
+        *aOutStride = LONG(aWidth) * 3;
+        return S_OK;
+      default:
+        return E_FAIL;
+    }
+  }
+#endif
   ENSURE_FUNCTION_PTR(MFGetStrideForBitmapInfoHeader, evr.dll)
   return (MFGetStrideForBitmapInfoHeaderPtr)(aFormat, aWidth, aOutStride);
 }
diff --git a/dom/media/platforms/wmf/WMFVideoMFTManager.cpp b/dom/media/platforms/wmf/WMFVideoMFTManager.cpp
index 5ea50b1664..1a91301cff 100644
--- a/dom/media/platforms/wmf/WMFVideoMFTManager.cpp
+++ b/dom/media/platforms/wmf/WMFVideoMFTManager.cpp
@@ -47,6 +47,11 @@ using mozilla::layers::LayerManager;
 using mozilla::layers::LayersBackend;
 using mozilla::media::TimeUnit;
 
+#if defined(GECKO_W10M)
+#  include "nsPrintfCString.h"
+extern "C" void GeckoW10mNote(const char* aText);
+#endif
+
 namespace mozilla {
 
 LayersBackend GetCompositorBackendType(
@@ -133,11 +138,18 @@ bool WMFVideoMFTManager::InitializeDXVA() {
     return false;
   }
 
+  // Upstream keeps DXVA in the RDD or GPU process so a decoded texture never
+  // has to be carried back to the parent. This port has neither process: the
+  // browser, the compositor and the decoder are one process, and the texture
+  // is handed straight to WebRender. The reason for the restriction does not
+  // apply here, and obeying it would mean decoding every frame on the CPU.
+#if !defined(GECKO_W10M)
   if (!XRE_IsRDDProcess() && !XRE_IsGPUProcess()) {
     mDXVAFailureReason.AssignLiteral(
         "DXVA only supported in RDD or GPU process");
     return false;
   }
+#endif
 
   bool d3d11 = true;
   if (!StaticPrefs::media_wmf_dxva_d3d11_enabled()) {
@@ -364,6 +376,31 @@ MediaResult WMFVideoMFTManager::InitInternal() {
   LOG("Video Decoder initialized, Using DXVA: {}",
       (mUseHwAccel ? "Yes" : "No"));
 
+#if defined(GECKO_W10M)
+  {
+    // Into the note log, which survives a restart -- the MOZ_LOG file does not,
+    // and a video that only misbehaves at 60 fps is hard to catch in the one
+    // session that happens to still have its log.
+    UINT32 numerator = 0;
+    UINT32 denominator = 1;
+    int fps = 0;
+    if (SUCCEEDED(MFGetAttributeRatio(inputType, MF_MT_FRAME_RATE,
+                                           &numerator, &denominator)) &&
+        denominator) {
+      fps = int((numerator + denominator / 2) / denominator);
+    }
+    // No %f here either; see the note in APZEventState.
+    nsPrintfCString note("media: %s %dx%d at %d fps, DXVA %s%s%s",
+                         EnumValueToString(mStreamType),
+                         mVideoInfo.ImageRect().width,
+                         mVideoInfo.ImageRect().height, fps,
+                         mUseHwAccel ? "YES" : "no",
+                         mUseHwAccel || mDXVAFailureReason.IsEmpty() ? "" : " -- ",
+                         mUseHwAccel ? "" : mDXVAFailureReason.get());
+    GeckoW10mNote(note.get());
+  }
+#endif
+
   // Now we need to convert the video decode output to a display format.
   if (mUseHwAccel) {
     RETURN_PARAM_IF_FAILED(
diff --git a/media/ffvpx/config.h b/media/ffvpx/config.h
index baf1fa959a..696a05163b 100644
--- a/media/ffvpx/config.h
+++ b/media/ffvpx/config.h
@@ -27,6 +27,13 @@
 #    endif
 #    if defined(_ARM64_)
 #      include "config_win64_aarch64.h"
+#    elif defined(_ARM_)
+// 32-bit ARM Windows: ffvpx ships no configuration for it. config_win32.h
+// is an x86 configuration, and config_generic.h assumes pthreads, so this
+// is the Windows configuration with every x86 (and ARM) assembly switch
+// turned off -- ffvpx's 32-bit ARM assembly is A32, and this platform is
+// Thumb-2 only. Regenerate with tools/gen-ffvpx-win32-arm-config.py.
+#      include "config_win32_arm.h"
 #    else
 #      if defined(HAVE_64BIT_BUILD)
 #        include "config_win64.h"
diff --git a/media/ffvpx/libavcodec/moz.build b/media/ffvpx/libavcodec/moz.build
index f9b65533fb..3ecf06fbeb 100644
--- a/media/ffvpx/libavcodec/moz.build
+++ b/media/ffvpx/libavcodec/moz.build
@@ -7,7 +7,9 @@
 if CONFIG['FFVPX_ASFLAGS']:
     if CONFIG['TARGET_CPU'] == 'x86' or CONFIG['TARGET_CPU'] == 'x86_64':
         DIRS += ['x86']
-    elif CONFIG['TARGET_CPU'] == 'arm':
+    elif CONFIG['TARGET_CPU'] == 'arm' and CONFIG['OS_TARGET'] != 'WINNT':
+        # ffvpx's 32-bit ARM assembly is A32 (ARM mode); Windows on ARM32
+        # is Thumb-2 only. See media/ffvpx/config.h.
         DIRS += ['arm']
 
 if CONFIG['TARGET_CPU'] == 'aarch64':
@@ -131,8 +133,13 @@ if not CONFIG['MOZ_FFVPX_AUDIOONLY']:
     else:
         USE_LIBS += [
             'dav1d',
-            'media_libdav1d_asm',
         ]
+        # The assembly half of dav1d is not built on every target (see
+        # MOZ_DAV1D_ASM in toolkit/moz.configure).
+        if CONFIG['MOZ_DAV1D_ASM']:
+            USE_LIBS += [
+                'media_libdav1d_asm',
+            ]
 
     if CONFIG["MOZ_WIDGET_TOOLKIT"] == "gtk":
         LOCAL_INCLUDES += ['/media/mozva']
diff --git a/media/ffvpx/libavutil/avutil.symbols b/media/ffvpx/libavutil/avutil.symbols
index b5d7c8e5d9..c24ea080ab 100644
--- a/media/ffvpx/libavutil/avutil.symbols
+++ b/media/ffvpx/libavutil/avutil.symbols
@@ -312,7 +312,7 @@ avpriv_float_dsp_alloc
 avpriv_report_missing_feature
 avpriv_request_sample
 avpriv_set_systematic_pal2
-#if defined(XP_WIN) && !defined(_ARM64_)
+#if defined(XP_WIN) && !defined(_ARM64_) && !defined(_ARM_)
 avpriv_emms_asm
 #endif
 avpriv_slicethread_create
