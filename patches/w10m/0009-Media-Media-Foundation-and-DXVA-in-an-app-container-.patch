         DIRS += ['arm']
 
 if CONFIG['TARGET_CPU'] == 'aarch64':
diff --git a/media/libpng/moz.build b/media/libpng/moz.build
index 7aec6c98ec..80817f8691 100644
--- a/media/libpng/moz.build
+++ b/media/libpng/moz.build
@@ -47,7 +47,9 @@ if CONFIG['TARGET_CPU'] == 'arm' or CONFIG['TARGET_CPU'] == 'aarch64':
         'arm/palette_neon_intrinsics.c'
     ]
 
-    if CONFIG['TARGET_CPU'] == 'arm':
+    # filter_neon.S is A32 (ARM mode) gas assembly; Windows on ARM32 is
+    # Thumb-2 only. filter_neon_intrinsics.c above covers the same filters.
