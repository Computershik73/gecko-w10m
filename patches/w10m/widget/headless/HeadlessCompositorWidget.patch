+++ b/widget/headless/HeadlessCompositorWidget.h
@@ -39,6 +39,20 @@ class HeadlessCompositorWidget final : public CompositorWidget,
     return this;
   }
 
+#if defined(GECKO_W10M)
+  // A headless compositor widget hands the software WebRender compositor no
+  // surface at all, so everything it paints goes nowhere. On Windows 10 Mobile
+  // there is no HWND for app content and headless is the only widget this port
+  // can create, which makes these two methods the whole of the path from Gecko
+  // to the screen: they paint into a plain BGRA buffer that the shell copies
+  // into a XAML bitmap.
+  already_AddRefed<gfx::DrawTarget> StartRemoteDrawingInRegion(
+      const LayoutDeviceIntRegion& aInvalidRegion) override;
+  void EndRemoteDrawingInRegion(
+      gfx::DrawTarget* aDrawTarget,
+      const LayoutDeviceIntRegion& aInvalidRegion) override;
+#endif
+
  private:
   HeadlessWidget* mWidget;
 
diff --git a/widget/headless/HeadlessWidget.cpp b/widget/headless/HeadlessWidget.cpp
index 0c28540ee6..274643edd9 100644
--- a/widget/headless/HeadlessWidget.cpp
+++ b/widget/headless/HeadlessWidget.cpp
@@ -91,7 +91,25 @@ HeadlessWidget::~HeadlessWidget() {
   Destroy();
 }
 
+#if defined(GECKO_W10M)
+namespace {
+// Raw, and main thread only. A strong reference here would keep a window
+// alive past its own teardown, which is worse than the discipline.
+HeadlessWidget* sShownWidget = nullptr;
+}  // namespace
+
+HeadlessWidget* HeadlessWidget::ShownWidget() {
+  MOZ_ASSERT(NS_IsMainThread());
+  return sShownWidget;
+}
+#endif
+
 void HeadlessWidget::Destroy() {
+#if defined(GECKO_W10M)
+  if (sShownWidget == this) {
+    sShownWidget = nullptr;
+  }
+#endif
   if (mDestroyed) {
     return;
   }
@@ -162,6 +180,13 @@ void HeadlessWidget::RaiseWindow() {
 }
 
 void HeadlessWidget::Show(bool aState) {
+#if defined(GECKO_W10M)
+  if (aState) {
+    // Last one shown wins, which after startup is the browser window: the
+    // graphics sanity test shows and hides one of its own before it.
+    sShownWidget = this;
+  }
+#endif
   mVisible = aState;
 
   LOG(("HeadlessWidget::Show [%p] state %d\n", (void*)this, aState));
