diff --git a/gfx/pixman/pixman/pixman/pixman-arm.c b/gfx/pixman/pixman/pixman/pixman-arm.c
index d271e96a72..020ba52b6e 100644
--- a/gfx/pixman/pixman/pixman/pixman-arm.c
+++ b/gfx/pixman/pixman/pixman/pixman-arm.c
@@ -48,6 +48,13 @@ detect_cpu_features (void)
 {
     arm_cpu_features_t features = 0;
 
+#if defined(__clang__)
+    /* clang implements no structured exception handling on 32-bit ARM Windows,
+     * so the trap-based probe cannot be compiled. Every Windows-on-ARM device
+     * is ARMv7 with mandatory NEON, which is what the probe would find. */
+    features |= ARM_V6;
+    features |= ARM_NEON;
+#else
     __try
     {
 	pixman_msvc_try_arm_simd_op ();
@@ -65,6 +72,7 @@ detect_cpu_features (void)
     __except (GetExceptionCode () == EXCEPTION_ILLEGAL_INSTRUCTION)
     {
     }
+#endif
 
     return features;
 }
