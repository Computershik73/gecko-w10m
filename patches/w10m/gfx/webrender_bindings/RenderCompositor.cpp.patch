+  } else {
+    char note[192];
+    SprintfLiteral(note, "gfx: the EGL compositor failed -- %s",
+                   nsPromiseFlatCString(aError).get());
+    GeckoW10mNote(note);
+  }
+  return compositor;
+#elif defined(XP_WIN)
   if (gfx::gfxVars::UseWebRenderANGLE()) {
     return RenderCompositorANGLE::Create(aWidget, aError);
   }
