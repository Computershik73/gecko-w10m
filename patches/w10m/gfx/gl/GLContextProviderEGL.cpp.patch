 /* static */
+#if defined(GECKO_W10M)
+// Share the device Gecko already made, rather than letting ANGLE make another.
+// There are three D3D11 devices in this process otherwise -- the XAML
+// compositor's, Gecko's, and ANGLE's own -- on a phone whose driver has to keep
+// all of them alive at once, and it is the XAML one that dies.
+//
+// This is what RenderCompositorANGLE does on the desktop for reasons of its
+// own. It simply never runs here, because that compositor wants an HWND, so
+// nothing was doing it. Three becomes two.
+static std::shared_ptr<EglDisplay> GeckoW10mEglDisplay(
+    nsACString* const out_failureId) {
+  static bool said = false;
+  if (const auto lib = GLLibraryEGL::Get(out_failureId)) {
+    if (auto* manager = gfx::DeviceManagerDx::Get()) {
+      if (const RefPtr<ID3D11Device> device = manager->GetCompositorDevice()) {
+        if (const auto shared = lib->CreateDisplay(device.get())) {
+          if (!said) {
+            said = true;
+            GeckoW10mNote("gfx: EGL is sharing the engine's D3D11 device");
+          }
+          return shared;
+        }
+      }
+    }
+  }
+  if (!said) {
+    said = true;
+    GeckoW10mNote("gfx: EGL could not share a device, ANGLE will make its own");
+  }
+  return DefaultEglDisplay(out_failureId);
+}
+#  define DefaultEglDisplay GeckoW10mEglDisplay
+#endif
