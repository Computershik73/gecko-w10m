+#if defined(GECKO_W10M)
+    // Here, not at the call site: fGetError clears the error, so the note
+    // above was eating it and my own read a moment later got EGL_SUCCESS.
+    //
+    // 0x3009 EGL_BAD_MATCH means the config has no window bit -- the context
