-        mContext->CopySubresourceRegion(mDecodeFence, 0, 0, 0, 0,
-                                        aInTexture.mTexture, aInTexture.mIndex,
-                                        &corner);
-        D3D11_MAPPED_SUBRESOURCE mapped;
-        if (SUCCEEDED(mContext->Map(mDecodeFence, 0, D3D11_MAP_READ, 0,
-                                    &mapped))) {
