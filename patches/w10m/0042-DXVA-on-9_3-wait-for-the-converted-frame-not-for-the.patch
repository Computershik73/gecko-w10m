-      }
-    }
-#endif
     // The D3D11TextureClientAllocator may return a different texture format
     // than preferred. In which case the destination texture will be BGRA32.
     // Eg. when NV12 is blocked by Gfx.
@@ -1405,6 +1380,17 @@ HRESULT D3D11DXVA2Manager::CopyTextureToImage(
         return E_FAIL;
       }
     }
+#if defined(GECKO_W10M)
+    // Frames that stay on the GPU (feature level 9_3, nothing shared) have
+    // nothing between the conversion and the compositor: no keyed mutex, no
+    // fence, no sync object. The compositor drew frames the Adreno had not
+    // finished converting yet -- what it showed was the frame that texture
+    // held before, several frames old. The decoder's thread waits here for
+    // the conversion, not the compositor's.
+    if (!mutex && mDevice == DeviceManagerDx::Get()->GetCompositorDevice()) {
+      WaitForConvertedFrame();
+    }
+#endif
     perfRecorder.Record();
   }
 
@@ -1435,6 +1421,71 @@ HRESULT D3D11DXVA2Manager::CopyTextureToImage(
   return S_OK;
 }
 
+#if defined(GECKO_W10M)
+void D3D11DXVA2Manager::WaitForConvertedFrame() {
+  if (mConvertedQueryFailed) {
+    return;
+  }
+  if (!mConvertedQuery) {
+    CD3D11_QUERY_DESC desc(D3D11_QUERY_EVENT);
+    if (FAILED(mDevice->CreateQuery(&desc, getter_AddRefs(mConvertedQuery)))) {
+      mConvertedQueryFailed = true;
+      GeckoW10mNote(
+          "media: no event query -- converted frames are not waited for");
+      return;
+    }
+  }
+  const TimeStamp start = TimeStamp::Now();
+  mContext->End(mConvertedQuery);
+  mContext->Flush();
+  double waitedMs = 0;
+  bool gaveUp = false;
+  for (;;) {
+    BOOL done = FALSE;
+    HRESULT hr = mContext->GetData(mConvertedQuery, &done, sizeof(done),
+                                   D3D11_ASYNC_GETDATA_DONOTFLUSH);
+    waitedMs = (TimeStamp::Now() - start).ToMilliseconds();
+    if (hr != S_FALSE) {
+      break;
+    }
+    if (waitedMs > 1000) {
+      gaveUp = true;
+      break;
+    }
+    // Sleep(1) sleeps a whole 15 ms tick on the phone; yield instead while
+    // the wait is short.
+    if (waitedMs < 4) {
+      SwitchToThread();
+    } else {
+      Sleep(1);
+    }
+  }
+  mWaitFrames++;
+  mWaitTotalMs += waitedMs;
+  mWaitMaxMs = std::max(mWaitMaxMs, waitedMs);
+  if (waitedMs > 33) {
+    mWaitLong++;
+  }
+  if (gaveUp) {
+    mWaitGaveUp++;
+  }
+  if (mWaitFrames == 300) {
+    nsPrintfCString note(
+        "media: %ux%u, 300 frames converted; waiting for the GPU to finish "
+        "one took %.1f ms on average, %.1f ms at most, over a frame's 33 ms "
+        "%u times, gave up %u times",
+        mWidth, mHeight, mWaitTotalMs / mWaitFrames, mWaitMaxMs, mWaitLong,
+        mWaitGaveUp);
+    GeckoW10mNote(note.get());
+    mWaitFrames = 0;
+    mWaitTotalMs = 0;
+    mWaitMaxMs = 0;
+    mWaitLong = 0;
+    mWaitGaveUp = 0;
+  }
+}
+#endif
