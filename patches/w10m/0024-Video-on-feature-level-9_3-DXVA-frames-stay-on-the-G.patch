diff --git a/gfx/layers/d3d11/GpuProcessD3D11TextureMap.cpp b/gfx/layers/d3d11/GpuProcessD3D11TextureMap.cpp
index 3819f0c91c..6200b786af 100644
--- a/gfx/layers/d3d11/GpuProcessD3D11TextureMap.cpp
