+#if defined(GECKO_W10M)
+  const auto start = TimeStamp::Now();
+#endif
   ret = CreateDisplayLocked({}, out_failureId, lock);
+#if defined(GECKO_W10M)
+  GeckoW10mNoteDefaultDisplay(*this, ret, *out_failureId, start);
+#endif
   mDefaultDisplay = ret;
   return ret;
 }
