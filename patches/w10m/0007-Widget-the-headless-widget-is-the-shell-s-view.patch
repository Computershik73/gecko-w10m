         aFailureId = "FEATURE_FAILURE_EMPTY_DRIVER_VERSION";
         *aStatus = FEATURE_BLOCKED_DRIVER_VERSION;
       } else {
         *aStatus = FEATURE_STATUS_OK;
       }
+#endif
       return NS_OK;
     }
 
