@@ -49,6 +49,13 @@ class WindowsDllDetourPatcherPrimitive {
   // LDR x16, .+8
   static const uint32_t kLdrX16Plus8 = 0x58000050U;
 #endif  // defined(_M_ARM64)
+#if defined(_M_ARM)
+  // Thumb-2: LDR.W pc, [pc, #0]. Encoded as the halfword pair F8DF F000, which
+  // in little-endian memory order is the word 0xF000F8DF. It loads the 32-bit
+  // word placed immediately after the instruction into pc, so the veneer is
+  // eight bytes and reaches the entire address space.
+  static const uint32_t kThumbLdrPcPcPlus0 = 0xF000F8DFU;
+#endif  // defined(_M_ARM)
 
   static void ApplyDefaultPatch(WritableTargetFunction<MMPolicyT>& target,
                                 intptr_t aDest) {
@@ -82,6 +89,10 @@ class WindowsDllDetourPatcherPrimitive {
     // BR x16
     target.WriteLong(arm64::BuildUnconditionalBranchToRegister(16));
     target.WritePointer(aDest);
+#elif defined(_M_ARM)
+    target.WriteLong(kThumbLdrPcPcPlus0);
+    // ARM32 code pointers carry the Thumb state in bit 0.
+    target.WritePointer(aDest | 1);
 #else
 #  error "Unsupported processor architecture"
 #endif
@@ -95,6 +106,8 @@ class WindowsDllDetourPatcherPrimitive {
     return 13;
