diff --git a/toolkit/library/build/moz.build b/toolkit/library/build/moz.build
index 72b02071e5..3961ca488a 100644
--- a/toolkit/library/build/moz.build
+++ b/toolkit/library/build/moz.build
@@ -40,3 +40,11 @@ if CONFIG["OS_ARCH"] == "Linux":
     OBJDIR_FILES.dist.bin += ["../libxul.so-gdb.py"]
 
 DUMP_SYMBOLS_FLAGS += ["--count-ctors"]
+
+# The Windows 10 Mobile port builds without debug symbols -- the objects would
+# not fit the machine and the link would take hours -- so a crash address off
+# the device has nothing to resolve against. A linker map costs only link time
+# and gives every symbol its RVA, which is enough to turn "xul.dll+0x3782930"
+# in the on-device log into a function name. See tools/symbolize.py.
+if CONFIG["MOZ_UWP"]:
+    LDFLAGS += ["-MAP:xul.map"]
