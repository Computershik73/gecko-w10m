+    # eme_modules is None when eme_choices is empty (see the comment above),
+    # which is the case for targets without EME support such as arm-uwp.
+    if modules and "wmfcdm" in modules:
         return True
 
 
@@ -1988,6 +1997,9 @@ def midl_flags(flags, target, midl):
             "x86": "win32",
             "x86_64": "x64",
             "aarch64": "arm64",
