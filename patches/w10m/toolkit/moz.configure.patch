         "x86_64": "i386:x86-64",
         "aarch64": "arm64",
+        # GeckoW10m: 32-bit ARM (Windows 10 Mobile).
+        "arm": "arm",
     }[target.cpu]
 
     return ["-m", arch]
@@ -2340,6 +2354,12 @@ with only_when(compile_environment):
     @depends(in_tree_vpx, vpx_nasm, target, neon_flags)
     def vpx_as_flags(vpx, vpx_nasm, target, neon_flags):
         if vpx and vpx.arm_asm:
+            if target.kernel == "WINNT":
+                # Windows on ARM32 assembles libvpx's .asm with armasm.exe,
