--- a/build/moz.configure/rust.configure
+++ b/build/moz.configure/rust.configure
@@ -525,9 +525,21 @@ def rust_host_triple(rustc, host, rustc_host, rust_supported_targets, arm_target
     return rustc_target
 
 
-@depends(rustc, target, rust_supported_targets, arm_target, when=rust_compiler)
+@depends(rustc, target, rust_supported_targets, arm_target, uwp, when=rust_compiler)
 @checking("for rust target triplet")
-def rust_target_triple(rustc, target, rust_supported_targets, arm_target):
+def rust_target_triple(rustc, target, rust_supported_targets, arm_target, uwp):
+    # GeckoW10m: for the ARM32 UWP (app container) build, use our own target rather
+    # than the desktop -pc variant the vendor-based detection would select. It is
+    # the built-in thumbv7a-uwp-windows-msvc with one field changed -- see
+    # mozconfig/rust-targets/ -- so that homogeneous float aggregates are passed
+    # in the VFP registers, the way the ARM32 Windows ABI requires and the way
+    # clang-cl passes them.
+    #
+    # The compile check is skipped for it: it builds a std-using crate with plain
+    # rustc, and this target's std lives in the sysroot only after
+    # tools/uwp-install-std.sh has run, which is itself driven from here.
+    if uwp and target.cpu == "arm":
+        return "thumbv7a-uwp-windows-msvchf"
     rustc_target = detect_rustc_target(target, arm_target, rust_supported_targets)
     assert_rust_compile(target, rustc_target, rustc)
     return rustc_target
