diff --git a/.cargo/config.toml.in b/.cargo/config.toml.in
index 0456f504e1..2d9ad2be93 100644
--- a/.cargo/config.toml.in
+++ b/.cargo/config.toml.in
@@ -170,3 +170,17 @@ directory = "third_party/rust"
 #filter substitution
 [source."@REPLACE_NAME@"]
 directory = "@top_srcdir@/@VENDORED_DIRECTORY@"
+
+# GeckoW10m: the ARM32 UWP build uses a Rust target of our own -- the built-in
+# thumbv7a-uwp-windows-msvc with llvm-target changed so that it ends in "hf",
+# which is what rustc tests to decide whether homogeneous float aggregates go
+# in the VFP registers. Without that, a struct of four floats is passed in
+# r1-r3 and the stack while clang-cl passes it in s0-s3, and every argument
+# after it is read from the wrong place.
+#
+# rustc finds the target through RUST_TARGET_PATH, and it has to be set here
+# rather than exported from the shell or from make: msys2 rewrites any variable
+# whose name ends in PATH, and the value never arrives. Cargo sets this itself
+# for every rustc it runs, so nothing is left to the environment.
+[env]
+RUST_TARGET_PATH = "C:/Users/User/Documents/GitHub/gecko-w10m/mozconfig/rust-targets"
