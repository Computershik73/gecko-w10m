+           ToString(aBounds).c_str(), ToString(aBounds).c_str());
+
+  auto clipId = DefineRoundedRectClip(Nothing(), aRegion);
+  auto clipChainId =
+      DefineClipChain({&clipId, 1}, CurrentClipChainIdIfNotRoot());
