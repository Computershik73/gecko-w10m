-bool ProgramExecutableD3D::hasNamedUniform(const std::string &name)
-{
-    for (D3DUniform *d3dUniform : mD3DUniforms)
-    {
-        if (d3dUniform->name == name)
-        {
-            return true;
-        }
-    }
