-    /// Perform a blit between self.bound_read_fbo and self.bound_draw_fbo.
-    fn blit_render_target_impl(
-        &mut self,
-        src_rect: FramebufferIntRect,
-        dest_rect: FramebufferIntRect,
-        filter: TextureFilter,
-    ) {
-        debug_assert!(self.inside_frame);
