+struct LoadNativeMenusListener {
+  LoadNativeMenusListener(Document* aDoc, nsIWidget* aParentWindow)
+      : mDocument(aDoc), mParentWindow(aParentWindow) {}
+
+  RefPtr<Document> mDocument;
+  nsCOMPtr<nsIWidget> mParentWindow;
