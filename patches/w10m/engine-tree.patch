+template <typename T>
+GLuint GetResourceMaxNameSize(const T &resource, GLint max)
+{
+    if (resource.isArray())
+    {
+        return std::max(max, clampCast<GLint>((resource.name + "[0]").size()));
+    }
+    else
+    {
