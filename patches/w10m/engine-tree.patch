-  if (aRaise == Raise::Yes) {
-    HeadlessWidget* topLevel = (HeadlessWidget*)GetTopLevelWidget();
-
-    // The toplevel only becomes active if it's currently visible; otherwise, it
-    // will be activated anyway when it's shown.
-    if (topLevel->IsVisible()) {
