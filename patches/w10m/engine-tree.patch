-/* static */
-void gfxPlatform::ResetHardwareVsyncSource() {
-  if (gPlatform->mGlobalHardwareVsyncSource) {
-    gPlatform->mGlobalHardwareVsyncSource->Shutdown();
-    gPlatform->mGlobalHardwareVsyncSource = nullptr;
-  }
