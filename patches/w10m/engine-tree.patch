+{
+    size_t maxLength = 0;
+
+    for (const ProgramInput &attrib : mProgramInputs)
+    {
+        maxLength = std::max(attrib.name.length() + 1, maxLength);
+    }
+
+    return static_cast<GLint>(maxLength);
+}
