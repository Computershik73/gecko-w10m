-void ProgramExecutable::hasSamplerTypeConflict(size_t textureUnit)
-{
-    // Conflicts are marked with InvalidEnum
-    mActiveSamplerYUV.reset(textureUnit);
-    mActiveSamplerTypes[textureUnit] = TextureType::InvalidEnum;
