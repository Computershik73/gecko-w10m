+extern "C" NS_EXPORT bool XRE_CheckBlockScopeStaticVarInit(
+    uint32_t* aTlsIndex) {
+  // Copy the value of xul's _tls_index for diagnostics.
+  if (aTlsIndex) {
+    *aTlsIndex = _tls_index;
+  }
