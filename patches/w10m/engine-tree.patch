-      FeatureStatus::UnavailableNoGpuProcess,
-      "Disabled by fallback to GPU Process disabled",
-      "FEATURE_FAILURE_DISABLED_BY_FALLBACK_GPU_PROCESS_DISABLED"_ns);
-
