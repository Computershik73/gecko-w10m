-HRESULT
-GetPictureRegion(IMFMediaType* aMediaType, gfx::IntRect& aOutPictureRegion) {
-  // Determine if "pan and scan" is enabled for this media. If it is, we
-  // only display a region of the video frame, not the entire frame.
