-                                          &mImage2DBindLayoutCache[shaderType]);
-    switch (shaderType)
-    {
-        case gl::ShaderType::Fragment:
-            updateCachedPixelExecutableIndex();
-            break;
-        case gl::ShaderType::Vertex:
