-
-  if (!alwaysSafe) {
-#if DEBUG
-    mIsSafeModeNecessary = false;
-#else
-    mIsSafeModeNecessary &= !PR_GetEnv("MOZ_DISABLE_AUTO_SAFE_MODE");
