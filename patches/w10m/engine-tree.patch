-    D3DUniform *targetUniform                   = getD3DUniformFromLocation(uniformLocation);
-    unsigned int arrayElementOffset             = uniformLocation.arrayIndex;
-    unsigned int elementCount                   = targetUniform->getArraySizeProduct();
