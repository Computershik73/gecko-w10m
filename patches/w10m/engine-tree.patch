+    /// (Re)allocates the storage of a VBO to `size` bytes, leaving the contents uninitialized.
+    pub fn reallocate_vbo(&mut self, vbo: VBOId, size: usize) {
+        debug_assert!(self.inside_frame);
+
+        vbo.bind(self.gl());
