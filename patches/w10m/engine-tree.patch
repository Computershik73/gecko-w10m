-        stream->readInt(&index);
-    }
-
-    for (gl::ShaderType shaderType : gl::AllShaderTypes())
-    {
-        size_t samplerCount = stream->readInt<size_t>();
-        for (size_t sampleIndex = 0; sampleIndex < samplerCount; ++sampleIndex)
