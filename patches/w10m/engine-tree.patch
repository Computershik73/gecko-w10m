+NS_IMETHODIMP AppWindow::GetPositionAndSize(int32_t* x, int32_t* y, int32_t* cx,
+                                            int32_t* cy) {
+  if (!mWindow) return NS_ERROR_FAILURE;
+
+  LayoutDeviceIntRect rect = mWindow->GetScreenBounds();
+
+  if (x) *x = rect.X();
+  if (y) *y = rect.Y();
+  if (cx) *cx = rect.Width();
+  if (cy) *cy = rect.Height();
+
+  return NS_OK;
+}
