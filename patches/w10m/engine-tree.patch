-        seinfo.fMask = 0;
-        seinfo.hwnd = nullptr;
-        seinfo.lpVerb = nullptr;
-        seinfo.lpFile = rundll32Path;
-        seinfo.lpParameters = args.get();
-        seinfo.lpDirectory = nullptr;
-        seinfo.nShow = SW_SHOWNORMAL;
