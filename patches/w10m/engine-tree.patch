-    gfxFontCache::GetCache()->Flush();
-    gfxFontCache::GetCache()->NotifyGlyphsChanged();
-  } else if (!strcmp("gfx.font_rendering.freetype.gamma", aPref) ||
-             !strcmp("gfx.font_rendering.freetype.enhanced_contrast", aPref)) {
