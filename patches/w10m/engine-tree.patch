+    },
+    getControlConfig(config) {
+      config.controlAttrs = {
+        ".linkURL": this._options.linkURL ?? "",
+        ".updateVersion": this._options.updateVersion ?? "",
+        ".transfer": this._options.transfer ?? "",
+      };
+      return config;
+    },
+  })
