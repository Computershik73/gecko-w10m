+                         static_cast<void*>(mManifestURI.get()));
+    GeckoW10mNote(note.get());
+  } else {
+    // Reaching this branch at all is the finding: the member was not null
+    // before anyone had a chance to set it.
+    nsPrintfCString note("manifest uri: already set to %p, skipping",
+                         static_cast<void*>(mManifestURI.get()));
+    GeckoW10mNote(note.get());
