+LayoutDeviceIntPoint HeadlessWidget::WidgetToScreenOffset() {
+  if (mWindowType == WindowType::Popup) {
+    return mBounds.TopLeft();
+  }
+  return GetTopLevelWidget()->GetBounds().TopLeft();
+}
