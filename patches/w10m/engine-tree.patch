-        RefPtr<RenderThread> thread = RenderThread::Get();
-        auto renderer =
-            MakeUnique<RendererOGL>(std::move(thread), std::move(compositor),
-                                    aWindowId, wrRenderer, aBridge);
-        if (wrRenderer && renderer) {
