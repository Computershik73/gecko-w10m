-                                RendererD3D *renderer,
-                                gl::BinaryInputStream *stream)
-{
-    gl::InfoLog &infoLog = mExecutable->getInfoLog();
-
-    reset();
-
-    DeviceIdentifier binaryDeviceIdentifier = {};
-    stream->readBytes(angle::byte_span_from_ref(binaryDeviceIdentifier));
