-        self.gl.blit_framebuffer(
-            src_x0,
-            src_y0,
-            src_x0 + src_rect.width(),
-            src_y0 + src_rect.height(),
-            dest_rect.min.x,
-            dest_rect.min.y,
-            dest_rect.max.x,
-            dest_rect.max.y,
-            gl::COLOR_BUFFER_BIT,
-            filter,
-        );
-    }
