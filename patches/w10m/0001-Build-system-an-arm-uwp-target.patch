new file mode 100644
index 0000000000..a17c703f9f
--- /dev/null
+++ b/build/moz.configure/uwp.configure
@@ -0,0 +1,47 @@
+# This Source Code Form is subject to the terms of the Mozilla Public
+# License, v. 2.0. If a copy of the MPL was not distributed with this
+# file, You can obtain one at http://mozilla.org/MPL/2.0/.
+
+# GeckoW10m: Universal Windows Platform (UWP) target support.
+#
+# Enables building Gecko as an app-container binary for Windows 10 (incl.
+# Windows 10 Mobile / arm). This restricts the Win32 surface to
+# WINAPI_FAMILY_APP, links the /store CRT, and turns off subsystems that rely
+# on spawning child processes (UWP runs single-process here).
+
+option("--enable-uwp", help="Build for the Universal Windows Platform (app container)")
+
+
+@depends("--enable-uwp", target)
+def uwp(enable_uwp, target):
+    if enable_uwp:
+        if target.os != "WINNT":
+            die("--enable-uwp is only valid when targeting Windows")
+        return True
+
+
+set_config("MOZ_UWP", True, when=uwp)
+set_define("MOZ_UWP", True, when=uwp)
+
+# Windows 10 Mobile is full Windows NT underneath: the ARM32 Windows SDK ships
+# import libraries for the whole desktop Win32 surface (kernel32, user32,
+# gdi32, shlwapi, version, wintrust, ...), and the OS exports those entry
+# points. WINAPI_PARTITION_APP is a certification policy expressed in headers,
+# not a kernel boundary, so building against the desktop partition is what lets
+# layout/gfx/widget compile at all. The binary is still linked -APPCONTAINER
+# and still runs inside the app container; anything the container blocks at
+# runtime shows up as a failing call, not a missing symbol.
+set_define("WINAPI_FAMILY", "WINAPI_FAMILY_DESKTOP_APP", when=uwp)
+
+# GeckoW10m's JIT wrappers key off this (see patches/w10m/runtime).
+set_define("GECKO_W10M", True, when=uwp)
+
+
+@depends(uwp)
+def uwp_single_process(uwp):
+    # UWP forbids CreateProcess for arbitrary children; force single-process.
+    return bool(uwp)
+
+
+set_config("MOZ_GECKO_SINGLE_PROCESS", True, when=uwp_single_process)
+set_define("MOZ_GECKO_SINGLE_PROCESS", True, when=uwp_single_process)
