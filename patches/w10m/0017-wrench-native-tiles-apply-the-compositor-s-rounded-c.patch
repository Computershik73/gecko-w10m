+// Whether the centre of pixel (x, y) is inside the rounded clip (no
+// antialiasing: edge pixels may differ from a render that has it).
+fn inside_rounded(x: i32, y: i32, r: &DeviceIntRect, radii: &ClipRadius) -> bool {
+    let (px, py) = (x as f32 + 0.5, y as f32 + 0.5);
+    let corners = [
+        (radii.top_left, r.min.x, r.min.y, 1.0, 1.0),
+        (radii.top_right, r.max.x, r.min.y, -1.0, 1.0),
+        (radii.bottom_right, r.max.x, r.max.y, -1.0, -1.0),
+        (radii.bottom_left, r.min.x, r.max.y, 1.0, -1.0),
+    ];
+    for &(rad, cx, cy, dx, dy) in &corners {
+        if rad <= 0 {
+            continue;
+        }
+        let rad = rad as f32;
+        let (ox, oy) = (cx as f32 + dx * rad, cy as f32 + dy * rad);
+        if (px - ox) * dx < 0.0 && (py - oy) * dy < 0.0 {
+            let (ex, ey) = (px - ox, py - oy);
+            if ex * ex + ey * ey > rad * rad {
+                return false;
+            }
+        }
+    }
+    true
+}
