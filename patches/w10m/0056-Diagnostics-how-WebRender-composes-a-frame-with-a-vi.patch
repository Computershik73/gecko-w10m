 gfx/wr/webrender/src/renderer/composite.rs | 21 ++++++
 gfx/wr/webrender/src/renderer/mod.rs       | 75 ++++++++++++++++++++--
 gfx/wr/webrender/src/tile_cache/mod.rs     |  6 ++
 4 files changed, 101 insertions(+), 6 deletions(-)

