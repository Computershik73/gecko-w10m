From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ilya Vysotsky <il.mohoff2016@yandex.ru>
Date: Fri, 2 Oct 2026 23:13:20 +0400
Subject: [PATCH] Video layer: above the browser while nothing of the page is
 in front of it

Build 132's test showed the display takes the video layer as a hardware
overlay only while its panel lies above the browser's; under it, with a
transparent hole, it was composed by the GPU whatever else was changed. WR
now tells the layer, per frame, whether any composited tile in front of the
video intersects it. The layer asks the shell (a new stack entry in the
sink) to raise the panel once the video has been uncovered for six
composites, and to lower it at once when something of the page -- a
player's controls, subtitles -- is drawn in front, or the video moves.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../GeckoW10mVideoLayer.cpp                   | 64 +++++++++++++++++--
 gfx/wr/webrender/src/renderer/mod.rs          | 36 +++++++++--
 2 files changed, 89 insertions(+), 11 deletions(-)

diff --git a/gfx/webrender_bindings/GeckoW10mVideoLayer.cpp b/gfx/webrender_bindings/GeckoW10mVideoLayer.cpp
index ab6c831e3d..9c16dbe575 100644
--- a/gfx/webrender_bindings/GeckoW10mVideoLayer.cpp
+++ b/gfx/webrender_bindings/GeckoW10mVideoLayer.cpp
@@ -50,6 +50,11 @@ struct GeckoW10mVideoLayerSink {
                 int32_t aClipWidth, int32_t aClipHeight, int32_t aChainWidth,
                 int32_t aChainHeight);
   void (*show)(int32_t aVisible);
+  // Above the browser's panel, or under it. The display takes the layer as
+  // a hardware overlay only above (the test in build 132: under the
+  // browser it was composed by the GPU whatever else was done), and above
+  // it hides whatever the page draws over the video.
+  void (*stack)(int32_t aAbove);
 };
 
 std::atomic<const GeckoW10mVideoLayerSink*> sSink{nullptr};
@@ -81,6 +86,12 @@ struct VideoLayer {
   Rect mClip;
   uint32_t mStableFrames = 0;
   bool mShown = false;
+  // Whether the panel lies above the browser's, and for how many composites
+  // in a row nothing of the page has been drawn in front of the video.
+  bool mAbove = false;
+  uint32_t mUncoveredFrames = 0;
+  uint32_t mStatAbove = 0;
+  uint32_t mStackNotes = 0;
   bool mPresented = false;
   uint32_t mPlacementNotes = 0;
 
@@ -127,8 +138,27 @@ struct VideoLayer {
     Hide();
   }
 
+  void Stack(bool aAbove) {
+    if (aAbove == mAbove) {
+      return;
+    }
+    mAbove = aAbove;
+    if (auto* sink = sSink.load()) {
+      sink->stack(aAbove ? 1 : 0);
+    }
+    if (mStackNotes < 40) {
+      ++mStackNotes;
+      Note(aAbove ? "video layer: above the browser -- nothing of the page "
+                    "is in front of the video"
+                  : "video layer: under the browser -- the page draws in "
+                    "front of the video, or it moved");
+    }
+  }
+
   void Hide() {
     mLastHole = false;
+    mUncoveredFrames = 0;
+    Stack(false);
     if (mShown) {
       if (auto* sink = sSink.load()) {
         sink->show(0);
@@ -311,8 +341,25 @@ struct VideoLayer {
 
   // 0: WebRender draws the video; 1: a hole, new this frame; 2: a hole that
   // was already there.
-  int32_t Offer(const mozilla::wr::ExternalImageId& aId, const float* aRects) {
+  int32_t Offer(const mozilla::wr::ExternalImageId& aId, const float* aRects,
+                bool aCovered) {
     const bool hole = OfferForHole(aId, aRects);
+    // Above the browser only while the hole is there -- the panel is where
+    // this frame's video is -- and nothing of the page is in front of it;
+    // under it at once otherwise. Raised only after a tenth of a second
+    // uncovered, so a player's controls fading in and out do not make the
+    // panel jump back and forth.
+    if (hole && !aCovered) {
+      if (++mUncoveredFrames >= 6) {
+        Stack(true);
+      }
+    } else {
+      mUncoveredFrames = 0;
+      Stack(false);
+    }
+    if (mAbove) {
+      ++mStatAbove;
+    }
     const int32_t answer = hole ? (mLastHole ? 2 : 1) : 0;
     mLastHole = hole;
     return answer;
@@ -448,17 +495,19 @@ struct VideoLayer {
                      "video layer: a hole in %u of the last %u composites; the "
                      "system says overlay %u, composed by the GPU %u, other "
                      "%u; a video present took %.1f ms, %u of %u turned "
-                     "down as the display was still busy%s",
+                     "down as the display was still busy; above the browser "
+                     "in %u composites%s",
                      mStatHoles, mStatFrames, mStatOverlay, mStatComposed,
                      mStatOther,
                      mStatPresents ? mStatPresentMs / mStatPresents : 0.0,
-                     mStatBusy, mStatPresents,
+                     mStatBusy, mStatPresents, mStatAbove,
                      mClip == mRect ? "" : "; the panel is clipped");
       Note(note);
       mStatFrames = mStatHoles = 0;
       mStatOverlay = mStatComposed = mStatOther = 0;
       mStatPresents = 0;
       mStatBusy = 0;
+      mStatAbove = 0;
       mStatPresentMs = 0;
     }
   }
@@ -485,11 +534,14 @@ extern "C" __declspec(dllexport) void gecko_w10m_video_layer_ack(
 
 // From WebRender's composite (renderer/composite.rs), for an opaque NV12
 // video about to be drawn: aRects is the video's rect and its visible part,
-// x0 y0 x1 y1 each, in device pixels. True: the display shows it, draw a
+// x0 y0 x1 y1 each, in device pixels; aCovered, whether anything of the
+// page is drawn in front of it this frame. True: the display shows it, draw a
 // transparent hole.
 extern "C" int32_t gecko_w10m_video_layer_frame(uint64_t aExternalImageId,
-                                                const float* aRects) {
-  return Layer().Offer(mozilla::wr::ToExternalImageId(aExternalImageId), aRects);
+                                                const float* aRects,
+                                                int32_t aCovered) {
+  return Layer().Offer(mozilla::wr::ToExternalImageId(aExternalImageId), aRects,
+                       aCovered != 0);
 }
 
 // From RenderCompositorEGL::EndFrame, once per presented frame.
diff --git a/gfx/wr/webrender/src/renderer/mod.rs b/gfx/wr/webrender/src/renderer/mod.rs
index 015cc289f4..965b4e4149 100644
--- a/gfx/wr/webrender/src/renderer/mod.rs
+++ b/gfx/wr/webrender/src/renderer/mod.rs
@@ -734,16 +734,24 @@ fn gecko_w10m_composite_stats(state: &CompositeState) {
 /// as a hardware overlay of its own (GeckoW10mVideoLayer.cpp). True when the
 /// display is showing it and the compositor should leave a transparent hole.
 /// 0: the compositor draws the video; 1: leave a hole, which is new this
-/// frame (draw it); 2: leave a hole, already there (not dirty).
+/// frame (draw it); 2: leave a hole, already there (not dirty). `covered`
+/// says whether anything of the page is drawn in front of the video this
+/// frame: the display takes the layer as an overlay only when it lies above
+/// the browser's, which it can only do while nothing is in front of it.
 #[cfg(windows)]
 extern "C" {
-    fn gecko_w10m_video_layer_frame(external_image_id: u64, rects: *const f32) -> i32;
+    fn gecko_w10m_video_layer_frame(
+        external_image_id: u64,
+        rects: *const f32,
+        covered: i32,
+    ) -> i32;
 }
 
 fn gecko_w10m_video_layer(
     id: api::ExternalImageId,
     tile_rect: &DeviceRect,
     clip_rect: &DeviceRect,
+    covered: bool,
 ) -> i32 {
     #[cfg(windows)]
     {
@@ -751,15 +759,32 @@ fn gecko_w10m_video_layer(
             tile_rect.min.x, tile_rect.min.y, tile_rect.max.x, tile_rect.max.y,
             clip_rect.min.x, clip_rect.min.y, clip_rect.max.x, clip_rect.max.y,
         ];
-        unsafe { gecko_w10m_video_layer_frame(id.0, rects.as_ptr()) }
+        unsafe { gecko_w10m_video_layer_frame(id.0, rects.as_ptr(), covered as i32) }
     }
     #[cfg(not(windows))]
     {
-        let _ = (id, tile_rect, clip_rect);
+        let _ = (id, tile_rect, clip_rect, covered);
         0
     }
 }
 
+/// Whether any tile in front of the one at `index` (a smaller z) draws
+/// something over `rect`. Tiles with nothing in them are not composited at
+/// all, so a tile in the list is content; its valid rect is where.
+fn gecko_w10m_covered(state: &CompositeState, index: usize, rect: &DeviceRect) -> bool {
+    let z = state.tiles[index].z_id.0;
+    state.tiles.iter().enumerate().any(|(other, tile)| {
+        if other == index || tile.z_id.0 >= z {
+            return false;
+        }
+        let valid = state.get_device_rect(&tile.local_valid_rect, tile.transform_index);
+        valid
+            .intersection(&tile.device_clip_rect)
+            .and_then(|r| r.intersection(rect))
+            .map_or(false, |r| r.width() >= 1.0 && r.height() >= 1.0)
+    })
+}
+
 /// This frame's holes: tile index, and whether the hole was already there.
 static GECKO_W10M_HOLES: std::sync::Mutex<Vec<(usize, bool)>> =
     std::sync::Mutex::new(Vec::new());
@@ -785,7 +810,8 @@ pub(crate) fn gecko_w10m_offer_videos(state: &CompositeState) {
                 let clip_rect = tile_rect
                     .intersection(&tile.device_clip_rect)
                     .unwrap_or(DeviceRect::zero());
-                match gecko_w10m_video_layer(id, &tile_rect, &clip_rect) {
+                let covered = gecko_w10m_covered(state, index, &clip_rect);
+                match gecko_w10m_video_layer(id, &tile_rect, &clip_rect, covered) {
                     1 => holes.push((index, false)),
                     2 => holes.push((index, true)),
                     _ => {}
