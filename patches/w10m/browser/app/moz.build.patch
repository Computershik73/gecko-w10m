     LINK_FLAGS["CETCOMPAT"] = []
 
-if CONFIG["DESKTOP_LAUNCHER_ENABLED"]:
+if CONFIG["DESKTOP_LAUNCHER_ENABLED"] and not CONFIG["MOZ_UWP"]:
     DIRS += [
         "desktop-launcher",
     ]
