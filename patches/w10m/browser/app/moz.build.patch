diff --git a/browser/app/moz.build b/browser/app/moz.build
index db09aba7e9..6fa3cea48a 100644
--- a/browser/app/moz.build
+++ b/browser/app/moz.build
@@ -159,17 +159,21 @@ if CONFIG["CC_TYPE"] == "clang-cl":
 
 if CONFIG["OS_ARCH"] == "WINNT":
     RCINCLUDE = "splash.rc"
-    DIRS += [
-        "installation_dir_layout",
-        "pbproxy",
-        "winlauncher",
-    ]
-    USE_LIBS += [
-        "winlauncher",
-    ]
-    LOCAL_INCLUDES += [
-        "/browser/app/winlauncher",
-    ]
+    # GeckoW10m: the launcher stub, its private-browsing proxy and the install
