+        DIRS += [
+            "installation_dir_layout",
+            "pbproxy",
+            "winlauncher",
+        ]
+        USE_LIBS += [
+            "winlauncher",
+        ]
+        LOCAL_INCLUDES += [
+            "/browser/app/winlauncher",
+        ]
     OS_LIBS += [
         "advapi32",
         "shell32",
@@ -197,7 +201,7 @@ if CONFIG["OS_ARCH"] == "WINNT":
