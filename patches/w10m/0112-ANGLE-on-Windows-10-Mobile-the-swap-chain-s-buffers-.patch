+        LONG capacityWidth  = 0;
+        LONG capacityHeight = 0;
+        AngleUwpPanelCapacity(&capacityWidth, &capacityHeight);
+        char note[256];
         snprintf(note, sizeof(note),
-                 "angle: swap chain resized to %dx%d in %llu ms (ResizeBuffers %llu ms)",
