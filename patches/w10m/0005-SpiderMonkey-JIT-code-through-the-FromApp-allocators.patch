diff --git a/js/src/jit/AtomicOp.h b/js/src/jit/AtomicOp.h
index 1a5ff25334..1e8fee5a5e 100644
--- a/js/src/jit/AtomicOp.h
+++ b/js/src/jit/AtomicOp.h
@@ -7,6 +7,13 @@
 
 #include <stdint.h>
 
+// On Windows/ARM, <winnt.h> defines MemoryBarrier as a macro (__dmb(...)),
+// which collides with js::jit::MemoryBarrier below. (On x86/x64 it is an inline
+// function, so this only bites on ARM.)
+#ifdef MemoryBarrier
+#  undef MemoryBarrier
+#endif
+
 namespace js {
 namespace jit {
 
diff --git a/js/src/jit/ProcessExecutableMemory.cpp b/js/src/jit/ProcessExecutableMemory.cpp
index cea7d764ca..16d6faaa88 100644
--- a/js/src/jit/ProcessExecutableMemory.cpp
+++ b/js/src/jit/ProcessExecutableMemory.cpp
@@ -8,6 +8,7 @@
 #include "mozilla/Atomics.h"
 #include "mozilla/DebugOnly.h"
 #include "mozilla/Maybe.h"
+#include "mozilla/Sprintf.h"
 #include "mozilla/PodOperations.h"
 #include "mozilla/TaggedAnonymousMemory.h"
 #include "mozilla/XorShift128PlusRNG.h"
@@ -47,6 +48,25 @@
 using namespace js;
 using namespace js::jit;
 
+#if defined(GECKO_W10M)
+// Defined in toolkit/xre/Bootstrap.cpp: one line to a file the shell names,
+// for when there is no debugger, no console and no MOZ_LOG yet.
+extern "C" void GeckoW10mNote(const char* text);
+#endif
+
+#if defined(XP_WIN) && defined(GECKO_W10M)
+// Inside an app container, VirtualAlloc and VirtualProtect refuse
+// PAGE_EXECUTE_READ / PAGE_EXECUTE_READWRITE no matter what the package
+// declares. The codeGeneration capability unlocks the *FromApp entry points
+// instead, which take identical arguments. Every executable-memory allocation
+// in this file has to go through them, or the JIT dies at startup on device.
+//
+// This is deliberately placed after the last #include so the macros only
+// rewrite the call sites below.
+#  define VirtualAlloc VirtualAllocFromApp
+#  define VirtualProtect VirtualProtectFromApp
+#endif
+
 #ifdef XP_WIN
 #  if defined(HAVE_64BIT_BUILD)
 #    define NEED_JIT_UNWIND_HANDLING
@@ -67,7 +87,10 @@ static void* ComputeRandomAllocationAddress() {
 #  ifdef HAVE_64BIT_BUILD
   static const uintptr_t base = 0x0000000080000000;
   static const uintptr_t mask = 0x000003ffffff0000;
-#  elif defined(_M_IX86) || defined(__i386__)
+#  elif defined(_M_IX86) || defined(__i386__) || defined(_M_ARM) || \
+      defined(__arm__)
+  // 32-bit x86 and 32-bit ARM (Windows 10 Mobile) share the same randomized
+  // executable-memory address range.
   static const uintptr_t base = 0x04000000;
   static const uintptr_t mask = 0x3fff0000;
 #  else
@@ -378,12 +401,47 @@ static DWORD ProtectionSettingToFlags(ProtectionSetting protection) {
 
 [[nodiscard]] static bool CommitPages(void* addr, size_t bytes,
                                       ProtectionSetting protection) {
-  void* p = VirtualAlloc(addr, bytes, MEM_COMMIT,
-                         ProtectionSettingToFlags(protection));
+  const DWORD wanted = ProtectionSettingToFlags(protection);
+
+#if defined(GECKO_W10M)
+  // An app container will not hand out an executable page at commit time:
+  // VirtualAllocFromApp answers PAGE_EXECUTE_READ with ERROR_INVALID_PARAMETER
+  // however the capability is declared. What codeGeneration grants is the
+  // transition, not the initial state -- memory is committed writable and then
+  // turned over, which is exactly the sequence the shell's startup probe has
+  // been demonstrating all along.
+  const DWORD committed = (wanted == PAGE_READWRITE) ? wanted : PAGE_READWRITE;
+#else
+  const DWORD committed = wanted;
+#endif
+
+  void* p = VirtualAlloc(addr, bytes, MEM_COMMIT, committed);
   if (!p) {
+#if defined(GECKO_W10M)
+    char note[128];
+    SprintfLiteral(note, "jit: commit of %u bytes at %p failed, 0x%x, err %u",
+                   unsigned(bytes), addr, unsigned(committed),
+                   unsigned(GetLastError()));
+    GeckoW10mNote(note);
+#endif
     return false;
   }
   MOZ_RELEASE_ASSERT(p == addr);
+
+#if defined(GECKO_W10M)
+  if (committed != wanted) {
+    ULONG previous = 0;
+    if (!VirtualProtect(addr, bytes, wanted, &previous)) {
+      char note[128];
+      SprintfLiteral(note, "jit: protect of %u bytes at %p to 0x%x failed, err %u",
+                     unsigned(bytes), addr, unsigned(wanted),
+                     unsigned(GetLastError()));
+      GeckoW10mNote(note);
+      return false;
+    }
+  }
+#endif
+
   return true;
 }
 
@@ -718,6 +776,17 @@ class ProcessExecutableMemory {
     MOZ_RELEASE_ASSERT(gc::SystemPageSize() <= ExecutableCodePageSize);
 
     void* p = ReserveProcessExecutableMemory(MaxCodeBytesPerProcess);
+#if defined(GECKO_W10M)
+    {
+      // Whether this succeeded decides whether there is a JIT at all, and a
+      // failure is otherwise only visible as an out-of-memory report from the
+      // first thing that tries to compile.
+      char note[96];
+      SprintfLiteral(note, "jit: reserved %u MB of executable memory at %p",
+                     unsigned(MaxCodeBytesPerProcess / (1024 * 1024)), p);
+      GeckoW10mNote(note);
+    }
+#endif
     if (!p) {
       return false;
     }
@@ -783,6 +852,15 @@ void* ProcessExecutableMemory::allocate(size_t bytes,
 
     // Check if we have enough pages available.
     if (pagesAllocated_ + numPages >= MaxCodePages) {
+#if defined(GECKO_W10M)
+      // The other way out of this function without a page, and the one that
+      // would mean the pool is simply too small rather than unusable.
+      char note[96];
+      SprintfLiteral(note, "jit: pool exhausted, %u of %u pages used, wanted %u",
+                     unsigned(pagesAllocated_), unsigned(MaxCodePages),
+                     unsigned(numPages));
+      GeckoW10mNote(note);
+#endif
       return nullptr;
     }
 
@@ -975,11 +1053,28 @@ bool js::jit::ReprotectRegion(void* start, size_t size,
 
 #  ifdef XP_WIN
   DWORD flags = ProtectionSettingToFlags(protection);
+#    if defined(GECKO_W10M)
+  // Not the re-commit trick here. An app container will not hand out an
+  // executable page through VirtualAllocFromApp at all -- it answers
+  // PAGE_EXECUTE_READ with ERROR_INVALID_PARAMETER, whatever the package
+  // declares. Changing the protection of a page the process already owns is a
+  // different question, and the one codeGeneration actually answers yes to.
+  ULONG previous = 0;
+  if (!VirtualProtect(pageStart, size, flags, &previous)) {
+    char note[128];
+    SprintfLiteral(note, "jit: reprotect of %u bytes at %p to 0x%x failed, err %u",
+                   unsigned(size), pageStart, unsigned(flags),
+                   unsigned(GetLastError()));
+    GeckoW10mNote(note);
+    return false;
+  }
+#    else
   // This is a essentially a VirtualProtect, but with lighter impact on
   // antivirus analysis. See bug 1823634.
   if (!VirtualAlloc(pageStart, size, MEM_COMMIT, flags)) {
     return false;
   }
+#    endif
 #  else
   unsigned flags = ProtectionSettingToFlags(protection);
   if (mprotect(pageStart, size, flags)) {
diff --git a/js/src/jit/ProcessExecutableMemory.h b/js/src/jit/ProcessExecutableMemory.h
index 4a08d4a623..86edca70c1 100644
--- a/js/src/jit/ProcessExecutableMemory.h
+++ b/js/src/jit/ProcessExecutableMemory.h
@@ -16,7 +16,15 @@ namespace jit {
 
 // Limit on the number of bytes of executable memory to prevent JIT spraying
 // attacks.
-#if JS_BITS_PER_WORD == 32
+#if defined(GECKO_W10M)
+// This is reserved as one contiguous block at startup, and a phone running a
+// 32-bit process has to fit it alongside a 132 MB engine and everything the
+// app host has already mapped. 140 MB is a reasonable share of a desktop's
+// address space and an unreasonable one here; when the reservation fails the
+// JIT has no memory to allocate from at all, and the first compile reports
+// out of memory on a device using 23 MB of its 2048 MB allowance.
+static const size_t MaxCodeBytesPerProcess = 32 * 1024 * 1024;
+#elif JS_BITS_PER_WORD == 32
 static const size_t MaxCodeBytesPerProcess = 140 * 1024 * 1024;
 #else
 // This is the largest number which satisfies various alignment static
diff --git a/js/src/jit/arm/Architecture-arm.cpp b/js/src/jit/arm/Architecture-arm.cpp
index 82c37d2d2a..44bc09786f 100644
--- a/js/src/jit/arm/Architecture-arm.cpp
+++ b/js/src/jit/arm/Architecture-arm.cpp
@@ -4,7 +4,8 @@
 
 #include "jit/arm/Architecture-arm.h"
 
-#if !defined(JS_SIMULATOR_ARM) && !defined(__APPLE__)
+#if !defined(JS_SIMULATOR_ARM) && !defined(__APPLE__) && defined(__linux__)
+// <elf.h> (ELF auxv hwcap parsing) is Linux-specific; not present on Windows.
 #  include <elf.h>
 #endif
 
@@ -19,6 +20,10 @@
 #  include <libkern/OSCacheControl.h>
 #endif
 
+#if defined(XP_WIN)
+#  include <processthreadsapi.h>  // FlushInstructionCache, GetCurrentProcess
+#endif
+
 #include "jit/arm/Assembler-arm.h"
 #include "jit/FlushICache.h"  // js::jit::FlushICache
 #include "jit/RegisterSets.h"
@@ -503,6 +508,10 @@ void FlushICache(void* code, size_t size) {
 #elif defined(XP_IOS)
   sys_icache_invalidate(code, size);
 
+#elif defined(XP_WIN)
+  // Windows on ARM: flush the instruction cache via the Win32 API.
+  ::FlushInstructionCache(::GetCurrentProcess(), code, size);
+
 #else
 #  error "Unexpected platform"
 #endif
@@ -520,3 +529,28 @@ void FlushExecutionContext() {
 
 }  // namespace jit
 }  // namespace js
+
+#if defined(XP_WIN) && defined(_M_ARM)
+// SpiderMonkey's ARM JIT soft-divide path emits calls to these ARM EABI divide
+// helpers (declared in js/src/jit/VMFunctions.h). On Android they come from
+// compiler-rt; the LLVM Windows package ships no ARM32 builtins lib, so define
+// them here. Signatures MUST match VMFunctions.h: int64_t f(int, int), with the
+// quotient in the low word (r0) and remainder in the high word (r1). Built with
+// +hwdiv so `/` and `%` use the hardware divide instruction.
+extern "C" {
+MOZ_EXPORT int64_t __aeabi_uidivmod(int aNum, int aDen) {
+  unsigned n = static_cast<unsigned>(aNum);
+  unsigned d = static_cast<unsigned>(aDen);
+  unsigned q = n / d;
+  unsigned r = n - q * d;
+  return static_cast<int64_t>((static_cast<uint64_t>(r) << 32) | q);
+}
+MOZ_EXPORT int64_t __aeabi_idivmod(int aNum, int aDen) {
+  int q = aNum / aDen;
+  int r = aNum - q * aDen;
+  return static_cast<int64_t>(
+      (static_cast<uint64_t>(static_cast<unsigned>(r)) << 32) |
+      static_cast<unsigned>(q));
+}
+}  // extern "C"
+#endif  // XP_WIN && _M_ARM
