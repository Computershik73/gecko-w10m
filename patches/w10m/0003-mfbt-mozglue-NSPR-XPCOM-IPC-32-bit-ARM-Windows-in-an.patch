@@ -539,8 +565,17 @@ Result<Ok, nsresult> StartupCache::WriteToDisk(WriteType aWriteType) {
   }
 
   if (entries.IsEmpty()) {
+#if defined(GECKO_W10M)
+    GeckoW10mNote("startup cache: nothing was requested this run, nothing to write");
