diff --git a/nsprpub/pr/src/md/windows/w95thred.c b/nsprpub/pr/src/md/windows/w95thred.c
index 76636d9546..e0a74b9e4c 100644
--- a/nsprpub/pr/src/md/windows/w95thred.c
+++ b/nsprpub/pr/src/md/windows/w95thred.c
@@ -260,12 +260,18 @@ _PR_MD_SET_CURRENT_THREAD_NAME(const char* name)
     info.dwThreadID = -1;
     info.dwFlags = 0;
 
+#if defined(_M_ARM) && defined(__clang__)
+    /* clang implements no SEH on 32-bit ARM Windows, and this exception is
+       purely a debugger thread-naming convention, so skip it. */
