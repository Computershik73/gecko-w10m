diff --git a/third_party/aom/aom_ports/aarch32_cpudetect.c b/third_party/aom/aom_ports/aarch32_cpudetect.c
index af6774c5d2..5181d43db2 100644
--- a/third_party/aom/aom_ports/aarch32_cpudetect.c
+++ b/third_party/aom/aom_ports/aarch32_cpudetect.c
@@ -33,6 +33,12 @@ static int arm_get_cpu_caps(void) {
   // MSVC has no inline __asm support for Arm, but it does let you __emit
   // instructions via their assembled hex code.
   // All of these instructions should be essentially nops.
+#if defined(__clang__)
+  // clang implements no structured exception handling on 32-bit ARM Windows,
+  // and it has no __emit either. Every Windows-on-ARM32 device is ARMv7 with
+  // mandatory NEON, so the probe has only one possible answer.
+  flags |= HAS_NEON;
+#else
   __try {
     // VORR q0,q0,q0
     __emit(0xF2200150);
@@ -40,6 +46,7 @@ static int arm_get_cpu_caps(void) {
   } __except (GetExceptionCode() == EXCEPTION_ILLEGAL_INSTRUCTION) {
     // Ignore exception.
   }
+#endif
 #endif  // HAVE_NEON
   return flags;
 }
