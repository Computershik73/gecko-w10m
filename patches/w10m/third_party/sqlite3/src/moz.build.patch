diff --git a/third_party/sqlite3/src/moz.build b/third_party/sqlite3/src/moz.build
index da931832e0..cb79cc589a 100644
--- a/third_party/sqlite3/src/moz.build
+++ b/third_party/sqlite3/src/moz.build
@@ -142,3 +142,8 @@ DEFINES['SQLITE_ENABLE_CARRAY'] = 1
 
 # The percentile extension is part of the amalgamation but disabled by default.
 DEFINES['SQLITE_ENABLE_PERCENTILE'] = 1
+
+# clang implements no structured exception handling on 32-bit ARM Windows, and
+# SQLite turns SEH on by default for any _MSC_VER build.
+if CONFIG["TARGET_CPU"] == "arm":
+    DEFINES["SQLITE_OMIT_SEH"] = True
